{
    "name": "ZAO MixZ",
    "short_name": "ZAO MixZ",
    "description": "Two deck DJ app for the ZAO: mix, effects, DJ controller support, streaming, and a phone remote.",
    "start_url": "/",
    "scope": "/",
    "id": "/",
    "display": "standalone",
    "display_override": [
        "standalone",
        "fullscreen"
    ],
    "background_color": "#07080c",
    "theme_color": "#00d4ff",
    "orientation": "any",
    "categories": [
        "music",
        "entertainment"
    ],
    "prefer_related_applications": false,
    "icons": [
        {
            "src": "icons/mixz-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "icons/mixz-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "icons/mixz-maskable-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "shortcuts": [
